# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it holds secrets.

# MongoDB connection string (Atlas or local)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name to use
MONGODB_DB=attendance

# Password required to open the app
ADMIN_PASSWORD=change-me

# Secret used to sign login cookies (32+ random chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Timezone used to decide what "today" is (IANA name)
APP_TIMEZONE=Asia/Kolkata

# Free Groq API key for reading bank statements (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: model override
GROQ_MODEL=openai/gpt-oss-120b
